# --- LLM provider selection (see app/models/config.py) ---
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

GROQ_API_KEY=
MISTRAL_API_KEY=

# --- PostgreSQL: OMOP_TEMP and OMOP_FINAL live in the same DB, different schemas ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=omopdb
DB_USER=postgres
DB_PASSWORD=
OMOP_TEMP_SCHEMA=omop_temp
OMOP_FINAL_SCHEMA=omop

# --- DQD (R) ---
# Path to Rscript executable and to the cloned/installed DataQualityDashboard package
RSCRIPT_BIN=Rscript
DQD_OUTPUT_DIR=runs

# --- CDM ---
CDM_VERSION=5.4
